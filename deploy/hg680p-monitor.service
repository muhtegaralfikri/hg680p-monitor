[Unit]
Description=HG680P lightweight server monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MONITOR_BIND=127.0.0.1:18099
Environment=MONITOR_SERVICES=nginx,php8.3-fpm,mariadb,cloudflared,docker
WorkingDirectory=/opt/hg680p-monitor
ExecStart=/opt/hg680p-monitor/hg680p-monitor
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
